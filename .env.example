# MongoDB connection string used by lib/dbConnect.js
MONGODB_URI=

# Auth.js session encryption secret; generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app; dev callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Resend API key for magic-link sign-in emails
AUTH_RESEND_KEY=
# Sender for magic-link emails, on a domain verified in Resend
EMAIL_FROM=
# Comma-separated emails that become admins when their user is first created
ADMIN_EMAILS=
# Production behind Nginx: trust the proxy's Host header and set the public URL
# AUTH_TRUST_HOST=true
# AUTH_URL=https://example.com
