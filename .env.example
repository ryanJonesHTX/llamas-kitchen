# The server refuses to start unless every var below is set (ADMIN_EMAILS is optional).
# MongoDB connection string used by lib/dbConnect.js
MONGODB_URI=

# Auth.js session encryption secret; generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app; dev callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Resend API key for magic-link sign-in emails
AUTH_RESEND_KEY=
# Sender for magic-link emails, on a domain verified in Resend
EMAIL_FROM=
# Comma-separated emails that become admins when their user is first created
ADMIN_EMAILS=
# Cloudinary product environment that receives recipe photos
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key, sent to admins' browsers with each upload signature
CLOUDINARY_API_KEY=
# Cloudinary API secret, used server-side only to sign uploads
CLOUDINARY_API_SECRET=
# Public site URL; required. Setting it makes Auth.js trust the host (no
# UntrustedHost behind Nginx), and next-auth rewrites the request origin to it.
# Production: https://food.ryanjones.dev
# Dev: http://localhost:3000
AUTH_URL=
